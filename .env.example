# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Postgres connection string (e.g. Neon, Supabase, or local Postgres).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# JWT_SECRET: random secret used to sign session tokens. Generate your own, never reuse this placeholder.
JWT_SECRET="CHANGE_ME_TO_A_RANDOM_SECRET"

# Twilio: SMS on booking + 1h-before reminder. Optional — if unset, sendSms() just logs and skips.
# Get these from https://console.twilio.com (Account SID, Auth Token, and a Twilio phone number).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
